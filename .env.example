# Base PostgreSQL
DATABASE_URL=postgres://postgres@localhost:5432/ompic
# Secret de signature des sessions (32+ caractères aléatoires)
AUTH_SECRET=change-me-with-a-long-random-string
# Clé API Anthropic pour l'agent IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Secret pour déclencher l'agent depuis un cron : POST /api/agent/run  (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me
# Cookie de session « Secure » : détecté automatiquement (HTTPS ou X-Forwarded-Proto). Forcer avec true/false si besoin.
# COOKIE_SECURE=
